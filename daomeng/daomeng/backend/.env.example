HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# disabled | shared | users
AUTH_MODE=users
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Optional separate key for encrypting model API credentials in the database.
SETTINGS_ENCRYPTION_KEY=replace-with-another-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MAX_SESSIONS_PER_USER=10
AUTH_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_ENABLED=true

# The admin account is created or promoted at startup.
ADMIN_EMAIL=admin@example.com
APP_ACCESS_PASSWORD=replace-with-a-strong-admin-password

# Use PostgreSQL in production. Local development falls back to SQLite.
DATABASE_URL=postgresql://user:password@host:5432/daomeng

# Mount persistent storage here in production.
RUNTIME_DATA_DIR=/var/data
MAX_UPLOAD_BYTES=26214400
MAX_USER_TEMP_BYTES=262144000
# Small-scale fallback for platforms without a persistent disk. For larger
# production traffic, replace this with S3/R2 object storage.
MEDIA_PERSISTENCE_MODE=database
DATABASE_MEDIA_MAX_FILE_BYTES=104857600
DATABASE_MEDIA_MAX_PROJECT_BYTES=524288000
MAX_PENDING_TASKS_PER_USER=10
MAX_CONCURRENT_TASKS_PER_USER=1
PIPELINE_WORKER_CONCURRENCY=1

ALLOWED_ORIGINS=http://localhost:3000
